!! My urxvt configuration, pretty standard and most of the stuff comes from the
!! Arch wiki: https://wiki.archlinux.org/index.php/Rxvt-unicode. Some packages
!! are required: rxvt-unicode, urxvt-perls, urxvt-resize-font-git (aur)

!! Urxvt
URxvt*termName:            xterm-256color
URxvt*buffered:            true
URxvt*loginShell:          true
URxvt*saveLines:           8000
URxvt*scrollBar:           false
URxvt*scrollstyle:         plain
URxvt*secondaryScroll:     true
URxvt.disallowedWindowOps: 20,21,SetXprop

!! Cosmetics
URxvt*font:           xft:DejaVu Sans Mono:size=12:antialias=true
URxvt*depth:          32
URxvt*borderless:     1
URxvt*transparent:    false
URxvt*shading:        40
URxvt*dynamicColors:  on
URxvt*underlineColor: yellow
URxvt*cursorColor:    cyan
URxvt*cursorBlink:    true
URxvt*geometry:       400x400
!! https://www.reddit.com/r/archlinux/comments/105t4ye/rxvtunicode_opens_in_the_middle_of_the_screen/

!! Extensions (confirm-paste asks before pasting control characters)
URxvt.perl-ext-common: default,matcher,keyboard-select,resize-font,confirm-paste

!! Copy / paste (see ~/.dotfiles/copypaste.org). Built-in urxvt actions on
!! Alt chords (M-c, M-v, M-space) that no terminal application (Emacs, tmux) uses.
!! PRIMARY <-> CLIPBOARD mirroring is autocutsel's job (xinitrc), not urxvt's.
URxvt.keysym.M-c:           eval:selection_to_clipboard
URxvt.keysym.M-v:           eval:paste_clipboard
URxvt.keysym.S-Insert:      eval:paste_clipboard
!! matcher (URLs): click, or M-S-u / M-S-l
URxvt.url-launcher:         firefox
URxvt.matcher.button:       1
URxvt.keysym.M-S-u:         perl:matcher:last
URxvt.keysym.M-S-l:         perl:matcher:list
!! keyboard-select
URxvt.keysym.M-space:       perl:keyboard-select:activate
URxvt.keysym.C-S-f:         perl:keyboard-select:search
!! Xft Settings
Xft.dpi:       96
Xft.antialias: true
Xft.rgba:      rgb
Xft.hinting:   true
Xft.hintstyle: hintslight

#include "Xlight_theme"
